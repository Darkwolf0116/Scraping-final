# Plantilla de entorno. Copia este archivo a .env y completa los valores.
#   copy .env.example .env      (Windows)   |   cp .env.example .env  (Unix)

# === Ollama (LLM local) ===
OLLAMA_BASE_URL=http://localhost:11434
# Modelo de chat del agente (tu Gemma local). NO necesita tool-calling: el
# contexto RAG se inyecta en el prompt por el orquestador.
AGENT_MODEL=gemma4:e4b
# Modelo de embeddings para el índice RAG (ya disponible localmente).
EMBEDDING_MODEL=embeddinggemma:latest

# === OpenFang (daemon REST) ===
OPENFANG_BASE_URL=http://127.0.0.1:4200
# Opcional: clave Bearer para la API REST del daemon (déjalo vacío en local).
# OPENFANG_API_KEY=
# Nombre del agente OpenFang que redacta las respuestas.
AGENT_NAME=asistente-publico

# === Documentos scrapeados ===
# Carpeta con los .md generados por el scraper (relativa al repo o absoluta).
SCRAPED_DATA_DIR=./output

# === Telegram — Bot público (MVP) ===
# Crea el bot con @BotFather (/newbot) y pega aquí el token.
# Sin token puedes probar igualmente con:  scripts/telegram_bot.py --ask "..."
TELEGRAM_BOT_TOKEN=

# === Fase 2 (bot interno / colector regulatorio / HITL) — aún no usados ===
# TELEGRAM_ADMIN_CHAT_ID=
# TELEGRAM_INTERNAL_GROUP_ID=
