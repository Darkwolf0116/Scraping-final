# Plantilla de entorno. Copia este archivo a .env y completa los valores.
#   copy .env.example .env      (Windows)   |   cp .env.example .env  (Unix)

# === Google Gemini (ÚNICO proveedor — chat + embeddings) ===
# Consigue tu API key gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY se sincroniza automáticamente desde GEMINI_API_KEY en env.py
# Modelo de chat. DEBE ser un ID del catálogo de OpenFang con soporte de tools.
# Recomendado (GA, barato, con tools): gemini-2.5-flash-lite.
# Alternativas válidas: gemini-2.5-flash, gemini-3.1-flash-lite-preview.
# OJO: "gemini-3.1-flash-lite" (sin -preview) NO existe → el agente no usaría sus tools.
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
# Modelo de embeddings (para el RAG vectorial).
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# === OpenFang (daemon REST + dashboard) ===
OPENFANG_BASE_URL=http://127.0.0.1:4200
# OPENFANG_API_KEY=
AGENT_NAME=asistente-publico

# === Documentos scrapeados (entrada del RAG) ===
SCRAPED_DATA_DIR=./output

# === Telegram — Bot público ===
# Crea el bot con @BotFather (/newbot) y pega aquí el token.
TELEGRAM_BOT_TOKEN=

# === Telegram — Canal interno / HITL (opcional) ===
# Chat del administrador que aprueba borradores regulatorios (Human-In-The-Loop).
# TELEGRAM_ADMIN_CHAT_ID=
# ID del grupo privado del personal interno -> se rutea al agente "asistente-interno".
# TELEGRAM_INTERNAL_GROUP_ID=
